<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.application.dbairline.controller.ModifyCrewWindowController">
   <children>
      <VBox>
         <children>
            <HBox spacing="20.0">
               <children>
                  <VBox>
                     <children>
                        <Label text="Equipaggio di cabina" />
                        <TableView fx:id="cabinCrewTable">
                           <columns>
                              <TableColumn fx:id="cabinCrewIdCol" prefWidth="75.0" text="Id" />
                              <TableColumn fx:id="cabinCrewNameCol" prefWidth="75.0" text="Nome" />
                              <TableColumn fx:id="cabinCrewSurnameCol" prefWidth="75.0" text="Cognome" />
                              <TableColumn fx:id="cabinCrewRoleCol" prefWidth="75.0" text="Ruolo" />
                              <TableColumn fx:id="cabinCrewRankCol" prefWidth="75.0" text="Grado" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="40.0">
                     <children>
                        <Button mnemonicParsing="false" onMouseClicked="#moveIn" text="&lt;-" />
                        <Button mnemonicParsing="false" onMouseClicked="#moveOut" text="-&gt;" />
                     </children>
                  </VBox>
                  <VBox layoutX="10.0" layoutY="10.0">
                     <children>
                        <Label text="Lista dipendenti" />
                        <TableView fx:id="employeeTable">
                           <columns>
                              <TableColumn fx:id="employeeIdCol" prefWidth="75.0" text="Id" />
                              <TableColumn fx:id="employeeNameCol" prefWidth="75.0" text="Nome" />
                              <TableColumn fx:id="employeeSurnameCol" prefWidth="75.0" text="Cognome" />
                              <TableColumn fx:id="employeeRoleCol" prefWidth="75.0" text="Ruolo" />
                              <TableColumn fx:id="employeeRankCol" prefWidth="75.0" text="Grado" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Button mnemonicParsing="false" onMouseClicked="#clearCabinCrewTable" text="Pulisci tabella">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            <HBox alignment="CENTER" spacing="50.0">
               <children>
                  <Button fx:id="insertButton" mnemonicParsing="false" onMouseClicked="#insert" text="Inserisci" />
                  <Button fx:id="closeButton" mnemonicParsing="false" onMouseClicked="#exitWindow" text="Cancella" />
               </children>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </HBox>
         </children>
         <padding>
            <Insets left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
