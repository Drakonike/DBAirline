                     <children>
                        <Button fx:id="closeButton" mnemonicParsing="false" onMouseClicked="#CloseWindow" text="Cancella" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="210.0" layoutY="40.0" prefHeight="100.0" prefWidth="200.0" GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="insertButton" mnemonicParsing="false" onMouseClicked="#modifyFlight" text="Modifica" />
                     </children>
                  </HBox>
               </children>
            </GridPane>
         </children>
      </VBox>
