<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.application.dbairline.controller.InsertConfigurationWindowController">
   <children>
      <VBox>
         <children>
            <GridPane>
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="195.0" minWidth="10.0" prefWidth="141.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="271.0" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Label text="Nome configurazione" />
                  <TextField fx:id="configNameTF" GridPane.columnIndex="1" />
               </children>
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </GridPane>
            <TableView fx:id="flightClassConfigTable" prefHeight="200.0">
              <columns>
                <TableColumn fx:id="flightClassNameCol" maxWidth="1.7976931348623157E308" prefWidth="140.0" text="Nome classe" />
                  <TableColumn fx:id="flightClassSeatsCol" maxWidth="1.7976931348623157E308" prefWidth="140.0" text="Numero posti" />
              </columns>
            </TableView>
            <GridPane alignment="CENTER">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <Button fx:id="insertFlightClassButton" mnemonicParsing="false" onMouseClicked="#InsertFlightClassInConfiguration" text="Inserisci nuova classe" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="210.0" layoutY="40.0" prefHeight="100.0" prefWidth="200.0" GridPane.rowIndex="3" />
                  <TextField fx:id="columnTF" GridPane.columnIndex="1" />
                  <TextField fx:id="rowTF" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Numero di righe" GridPane.rowIndex="1" />
                  <Label text="Numero di colonne" />
                  <Label layoutX="10.0" layoutY="47.0" text="Classe di volo" GridPane.rowIndex="2" />
                  <ChoiceBox fx:id="flightClassesCB" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            <GridPane alignment="CENTER" layoutX="10.0" layoutY="310.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="closeButton" mnemonicParsing="false" onMouseClicked="#CloseWindow" text="Cancella" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="210.0" layoutY="40.0" prefHeight="100.0" prefWidth="200.0" GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="insertButton" mnemonicParsing="false" onMouseClicked="#insert" text="Inserisci" />
                     </children>
                  </HBox>
               </children>
            </GridPane>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
