<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.application.dbairline.controller.InsertFlightWindowController">
   <children>
      <VBox>
         <children>
            <GridPane>
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="195.0" minWidth="10.0" prefWidth="141.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Label text="Numero di volo" />
                  <Label text="Numero tratta" GridPane.rowIndex="1" />
                  <ChoiceBox fx:id="legNumberCB" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <ChoiceBox fx:id="flightNumberCB" layoutX="210.0" layoutY="43.0" prefWidth="150.0" GridPane.columnIndex="1" />
                  <Label text="Data partenza" GridPane.rowIndex="2" />
                  <DatePicker fx:id="departureDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <DatePicker fx:id="arrivalDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Data arrivo" GridPane.rowIndex="3" />
                  <Label text="Ora partenza" GridPane.rowIndex="4" />
                  <Label text="Ora arrivo" GridPane.rowIndex="5" />
                  <Label text="Aereo" GridPane.rowIndex="7" />
                  <Label text="Configurazione aereo" GridPane.rowIndex="8" />
                  <ChoiceBox fx:id="aircraftConfigCB" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                  <ChoiceBox fx:id="aircraftCB" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                  <HBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="4">
                     <children>
                        <Label text="hh:" />
                        <ChoiceBox fx:id="departureHourCB" />
                        <Label layoutX="10.0" layoutY="17.0" text="mm:" />
                        <ChoiceBox fx:id="departureMinuteCB" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="5">
                     <children>
                        <Label text="hh:" />
                        <ChoiceBox fx:id="arrivalHourCB" />
                        <Label text="mm:" />
                        <ChoiceBox fx:id="arrivalMinuteCB" />
                     </children>
                  </HBox>
                  <CheckBox fx:id="autoArrTimeCheckbox" mnemonicParsing="false" onMouseClicked="#disableArrTimePicker" text="Tempo di arrivo automatico" GridPane.columnIndex="1" GridPane.rowIndex="6" />
               </children>
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </GridPane>
            <GridPane alignment="CENTER">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="closeButton" mnemonicParsing="false" onMouseClicked="#CloseWindow" text="Cancella" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="210.0" layoutY="40.0" prefHeight="100.0" prefWidth="200.0" GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="insertButton" mnemonicParsing="false" onMouseClicked="#insertFlight" text="Inserisci" />
                     </children>
                  </HBox>
               </children>
            </GridPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
