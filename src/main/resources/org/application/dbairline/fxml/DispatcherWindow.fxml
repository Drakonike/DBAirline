                                          <TableColumn fx:id="flightAircraftConfigCol" prefWidth="100.0" text="Configurazione" />
                                          <TableColumn fx:id="flightAltAirportCol" prefWidth="120.0" text="AeroportoAlternativ" />
                                          <TableColumn fx:id="flightCancelledCol" prefWidth="109.0" text="VoloCancellato" />
                                       </columns>
                                       <VBox.margin>
                                          <Insets left="10.0" />
                                       </VBox.margin>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                    <FlowPane alignment="CENTER" hgap="10.0" prefHeight="27.0" prefWidth="701.0">
                                       <children>
                                          <Button id="InsertNewFlight" mnemonicParsing="false" onMouseClicked="#insertFlight" text="Inserisci volo">
                                             <FlowPane.margin>
                                                <Insets />
                                             </FlowPane.margin>
                                          </Button>
                                          <Button id="InsertNewFlight" layoutX="513.0" layoutY="10.0" mnemonicParsing="false" onMouseClicked="#modifyFlight" text="Modifica volo" />
                                          <Button id="InsertNewFlight" mnemonicParsing="false" onMouseClicked="#insertRefuel" text="Inserisci rifonimento" />
                                          <Button id="InsertNewFlight" layoutX="600.0" layoutY="10.0" mnemonicParsing="false" onMouseClicked="#modifyCabinCrew" text="Modifica Equipaggio di volo" />
                                       </children>
                                       <VBox.margin>
                                          <Insets left="30.0" top="10.0" />
                                       </VBox.margin>
                                    </FlowPane>
                                 </children>
                              </VBox>
                              <HBox layoutX="10.0" layoutY="10.0" prefHeight="400.0" prefWidth="1246.0">
                                 <children>
                                    <VBox>
                                       <children>
                                          <Label text="Rifornimenti">
                                             <VBox.margin>
                                                <Insets left="10.0" />
                                             </VBox.margin>
                                          </Label>
                                          <TableView id="FlightsTable" fx:id="refuelsTable">
                                             <columns>
                                                <TableColumn fx:id="refuelsFlightIdColumn" minWidth="-1.0" prefWidth="120.0" resizable="false" text="IdVolo" />
                                                <TableColumn fx:id="refuelsFuelTypeColumn" minWidth="-1.0" prefWidth="120.0" text="Tipo di carburante" />
                                                <TableColumn fx:id="refuelsQuantityColumn" minWidth="-1.0" prefWidth="120.0" text="Quantità" />
                                                <TableColumn fx:id="refuelsCostColumn" minWidth="-1.0" prefWidth="120.0" text="Costo" />
                                             </columns>
                                             <VBox.margin>
                                                <Insets left="10.0" />
                                             </VBox.margin>
                                          </TableView>
                                       </children>
                                    </VBox>
                                 </children>
                                 <VBox.margin>
                                    <Insets bottom="10.0" />
                                 </VBox.margin>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
