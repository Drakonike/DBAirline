<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="MainWindow" prefHeight="800.0" prefWidth="1440.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.application.dbairline.controller.DispatcherWindowController">
  <children>
      <TabPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="Itinerari e aeroporti">
               <content>
                  <Pane prefHeight="200.0" prefWidth="200.0">
                     <children>
                        <VBox>
                           <children>
                              <HBox spacing="10.0">
                                 <children>
                                    <VBox>
                                       <children>
                                          <Label text="Itinerari">
                                             <VBox.margin>
                                                <Insets />
                                             </VBox.margin>
                                          </Label>
                                          <TableView fx:id="itinerariesTable" prefWidth="300.0">
                                            <columns>
                                              <TableColumn fx:id="itinerariesFlightNumCol" prefWidth="150.0" text="Numero di volo" />
                                              <TableColumn fx:id="itinerariesFlightTypeCol" prefWidth="150.0" text="Tipo" />
                                            </columns>
                                             <VBox.margin>
                                                <Insets />
                                             </VBox.margin>
                                          </TableView>
                                          <Button mnemonicParsing="false" onMouseClicked="#insertItinerary" text="Inserisci itinerario" translateX="10.0" />
                                       </children>
                                    </VBox>
                                    <VBox>
                                       <children>
                                          <Label text="Tratte" />
                                          <TableView fx:id="flightLegsTable" prefWidth="300.0">
                                             <columns>
                                                <TableColumn fx:id="flightLegslegNumberColumn" prefWidth="100.0" text="Numero tratta" />
                                                <TableColumn fx:id="flightLegsDepartureColumn" prefWidth="100.0" text="Partenza" />
                                                <TableColumn fx:id="flightLegsArrivalColumn" prefWidth="100.0" text="Destinazione" />
                                             </columns>
                                          </TableView>
                                          <Button mnemonicParsing="false" onMouseClicked="#insertLeg" text="Inserisci tratta" translateX="10.0" />
                                       </children>
                                       <HBox.margin>
                                          <Insets left="10.0" />
                                       </HBox.margin>
                                    </VBox>
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" />
                                 </padding>
                              </HBox>
                              <VBox>
                                 <children>
                                    <Label text="Aeroporti" />
                                    <HBox>
                                       <children>
                                          <VBox>
                                             <children>
                                                <TableView fx:id="airportsTable" prefHeight="250.0">
                                                  <columns>
                                                    <TableColumn fx:id="airportsICAOCodeColumn" prefWidth="100.0" text="ICAO" />
                                                    <TableColumn fx:id="airportsIATACodeColumn" prefWidth="100.0" text="IATA" />
                                                      <TableColumn fx:id="airportsCommercialNameColumn" prefWidth="100.0" text="Nome Commerciale" />
                                                      <TableColumn fx:id="airportsCityColumn" prefWidth="100.0" text="Città" />
                                                       <TableColumn fx:id="airportsCountryColumn" prefWidth="100.0" text="Nazione" />
                                                      <TableColumn fx:id="airportsManagerColumn" prefWidth="100.0" text="Gestore" />
                                                      <TableColumn fx:id="airportsManagerContactColumn" prefWidth="100.0" text="Contatto gestore" />
                                                      <TableColumn fx:id="airportsTelephoneColumn" prefWidth="100.0" text="Telefono" />
                                                      <TableColumn fx:id="airportsFaxNumberColumn" prefWidth="100.0" text="Fax" />
                                                  </columns>
                                                </TableView>
                                                <Button mnemonicParsing="false" onMouseClicked="#insertAirport" text="Inserisci aeroporto" translateX="10.0" />
                                             </children>
                                          </VBox>
                                          <Pane layoutX="876.0" layoutY="10.0" prefHeight="200.0" prefWidth="50.0" />
                                       </children>
                                    </HBox>
                                 </children>
                                 <VBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" />
                                 </VBox.margin>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </Pane>
               </content>
            </Tab>
          <Tab text="Voli e rifornimenti">
               <content>
                  <HBox prefHeight="791.0" prefWidth="1441.0">
                     <children>
                        <VBox prefHeight="791.0" prefWidth="1428.0">
                           <children>
                              <VBox prefHeight="516.0" prefWidth="1442.0">
